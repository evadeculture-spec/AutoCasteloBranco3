# Postgres. Em Netlify DB a variável NETLIFY_DATABASE_URL é injetada automaticamente.
DATABASE_URL=postgres://acb:acb@localhost:5432/acb
# URL público do site (SEO, sitemap, Open Graph, emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Segredo para hash de IP (rate limit / visualizações). Qualquer string longa e aleatória.
APP_SECRET=troque-isto-por-uma-string-aleatoria-longa
# Opcional: notificações por email via Resend
RESEND_API_KEY=
EMAIL_FROM="AutoCasteloBranco <onboarding@resend.dev>"
EMAIL_NOTIFY_TO=
# Opcional: forçar armazenamento local de imagens mesmo dentro da Netlify (dev)
# STORAGE_DRIVER=local
